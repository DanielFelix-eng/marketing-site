---
import Layout from '../layouts/layout.astro';
import { SIGNUP_URL, SITE_URL } from '../config';

const plans = [
  {
    key: 'free',
    name: 'Free',
    monthly: 0,
    yearly: 0,
    billingNote: 'Free forever',
    badge: 'Powered by Nudge',
    cta: 'Start free',
    href: SIGNUP_URL,
    featured: false,
    features: ['100 AI replies/month', '1 widget', '3 documents', '1 seat', 'Powered by Nudge branding'],
    compare: {
      replies: '100',
      widgets: '1',
      documents: '3',
      seats: '1',
      branding: 'Powered by Nudge',
      analytics: 'No',
      handoff: 'No',
      apiAccess: 'No',
      support: 'Community'
    }
  },
  {
    key: 'starter',
    name: 'Starter',
    monthly: 300,
    yearly: 3000,
    billingNote: 'KES 300 /month',
    badge: 'For small teams',
    cta: 'Get started',
    href: `${SIGNUP_URL}?plan=starter`,
    featured: false,
    features: ['1,500 AI replies/month', '1 widget', '25 documents', '2 seats', 'Remove branding'],
    compare: {
      replies: '1,500',
      widgets: '1',
      documents: '25',
      seats: '2',
      branding: 'Removed',
      analytics: 'No',
      handoff: 'No',
      apiAccess: 'No',
      support: 'Standard'
    }
  },
  {
    key: 'pro',
    name: 'Pro',
    monthly: 600,
    yearly: 6000,
    billingNote: 'KES 600 /month',
    badge: 'Most popular',
    cta: 'Get started',
    href: `${SIGNUP_URL}?plan=pro`,
    featured: true,
    features: ['6,000 AI replies/month', '3 widgets', '100 documents', '5 seats', 'Remove branding', 'Analytics', 'Live handoff to a human'],
    compare: {
      replies: '6,000',
      widgets: '3',
      documents: '100',
      seats: '5',
      branding: 'Removed',
      analytics: 'Yes',
      handoff: 'Yes',
      apiAccess: 'No',
      support: 'Standard'
    }
  },
  {
    key: 'business',
    name: 'Business',
    monthly: 16500,
    yearly: 165000,
    billingNote: 'KES 16,500 /month',
    badge: 'For growing teams',
    cta: 'Get started',
    href: `${SIGNUP_URL}?plan=business`,
    featured: false,
    features: ['25,000 AI replies/month', '10 widgets', '500 documents', '15 seats', 'Remove branding', 'Analytics', 'Live handoff to a human', 'API access', 'Priority support'],
    compare: {
      replies: '25,000',
      widgets: '10',
      documents: '500',
      seats: '15',
      branding: 'Removed',
      analytics: 'Yes',
      handoff: 'Yes',
      apiAccess: 'Yes',
      support: 'Priority'
    }
  }
];

const comparisonRows = [
  {
    label: 'AI replies / month',
    values: plans.reduce((acc, plan) => ({ ...acc, [plan.key]: plan.compare.replies }), {})
  },
  {
    label: 'Widgets',
    values: plans.reduce((acc, plan) => ({ ...acc, [plan.key]: plan.compare.widgets }), {})
  },
  {
    label: 'Documents',
    values: plans.reduce((acc, plan) => ({ ...acc, [plan.key]: plan.compare.documents }), {})
  },
  {
    label: 'Seats',
    values: plans.reduce((acc, plan) => ({ ...acc, [plan.key]: plan.compare.seats }), {})
  },
  {
    label: 'Branding',
    values: plans.reduce((acc, plan) => ({ ...acc, [plan.key]: plan.compare.branding }), {})
  },
  {
    label: 'Analytics',
    values: plans.reduce((acc, plan) => ({ ...acc, [plan.key]: plan.compare.analytics }), {})
  },
  {
    label: 'Live handoff',
    values: plans.reduce((acc, plan) => ({ ...acc, [plan.key]: plan.compare.handoff }), {})
  },
  {
    label: 'API access',
    values: plans.reduce((acc, plan) => ({ ...acc, [plan.key]: plan.compare.apiAccess }), {})
  },
  {
    label: 'Support',
    values: plans.reduce((acc, plan) => ({ ...acc, [plan.key]: plan.compare.support }), {})
  }
];

const faqs = [
  {
    q: 'Is the free plan really free?',
    a: 'Yes. The Free plan has no time limit, no card required, and no hidden trial. It includes 100 AI replies each month, 1 widget, and 3 documents.'
  },
  {
    q: 'What happens when I hit the monthly reply limit?',
    a: 'Visitors see a polite unavailable message until the monthly reply reset. Your content stays safe and secure, and the counter resets automatically at the start of the next month or when you upgrade to a higher plan.'
  },
  {
    q: 'Can I use one website per workspace and how does domain verification work?',
    a: 'Each workspace is tied to a single website. To verify your domain, you add the DNS records or use your hosting provider flow in the workspace settings so Nudge can confirm ownership before it starts answering on that site.'
  },
  {
    q: 'Can I pay with M-Pesa through Paystack?',
    a: 'Yes. Paystack supports M-Pesa in Kenya. When you choose a paid plan, you complete the payment in the Paystack flow, which prompts your phone for confirmation and asks you to approve with your M-Pesa PIN.'
  },
  {
    q: 'What happens if I downgrade or miss a payment?',
    a: 'Your data is kept and your workspace remains available, but any items above the new plan limit are paused until you upgrade again or your billing is restored. We do not delete your documents or history during a downgrade.'
  },
  {
    q: 'Can I switch between monthly and yearly billing?',
    a: 'Yes. You can switch between monthly and yearly billing at any time from your workspace billing settings. Yearly pricing is billed as 10 months for the price of 12, which is effectively 2 months free.'
  }
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a
    }
  }))
};

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Nudge',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: plans
    .filter((plan) => plan.monthly > 0)
    .map((plan) => ({
      '@type': 'Offer',
      name: `${plan.name} plan`,
      price: String(plan.monthly),
      priceCurrency: 'KES',
      url: `${SIGNUP_URL}?plan=${plan.key}`
    }))
};
---

<Layout
  title="Nudge pricing | KES plans for AI customer support"
  description="Compare Nudge pricing in KES with a free forever plan and monthly or yearly billing. Start free or upgrade when you need more AI replies, widgets, and documents."
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <section class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-700">Simple pricing</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">
        A plan that grows with your business.
      </h1>
      <p class="mt-5 text-lg leading-8 text-slate-600">
        Start free and upgrade when you need more AI replies, widgets, or documents.
      </p>
    </section>

    <section id="plans" aria-label="Nudge plans" class="scroll-mt-8">
      <div class="mt-10 flex justify-center">
        <div class="inline-flex rounded-full border border-slate-200 bg-white p-1 shadow-sm" role="tablist" aria-label="Billing cycle selector">
          <button
            type="button"
            data-billing-cycle="monthly"
            aria-pressed="true"
            class="rounded-full px-4 py-2 text-sm font-medium text-slate-700 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
          >
            Monthly
          </button>
          <button
            type="button"
            data-billing-cycle="yearly"
            aria-pressed="false"
            class="rounded-full px-4 py-2 text-sm font-medium text-slate-700 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
          >
            Yearly <span class="text-[10px] font-semibold text-indigo-700">2 months free</span>
          </button>
        </div>
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {plans.map((plan) => (
          <article
            class={`flex flex-col rounded-2xl border bg-white p-5 shadow-sm transition sm:p-6 ${
              plan.featured ? 'border-indigo-600 ring-1 ring-indigo-600 shadow-indigo-100' : 'border-slate-200'
            }`}
          >
            <div class="flex items-start justify-between gap-3">
              <h2 class="text-xl font-semibold text-slate-900">{plan.name}</h2>
              {plan.featured && (
                <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-indigo-700">
                  Most popular
                </span>
              )}
            </div>

            {plan.badge && (
              <p class="mt-3 text-sm font-medium text-slate-600">{plan.badge}</p>
            )}

            <div class="mt-6">
              <div class="flex items-end gap-2">
                <span class="monthly-price text-4xl font-semibold tracking-tight text-slate-950">KES {plan.monthly.toLocaleString()}</span>
                <span class="yearly-price hidden text-4xl font-semibold tracking-tight text-slate-950">KES {plan.yearly.toLocaleString()}</span>
                <span class="text-sm text-slate-500">/month</span>
              </div>
              <p class="mt-2 text-sm text-slate-500">
                <span class="monthly-price">{plan.billingNote}</span>
                <span class="yearly-price hidden">KES {plan.yearly.toLocaleString()} /year · 2 months free</span>
              </p>
            </div>

            <ul class="mt-7 flex-1 space-y-3">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-3 text-sm leading-6 text-slate-600">
                  <span class="mt-1 font-semibold text-indigo-700" aria-hidden="true">✓</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <a
              href={plan.href}
              class={`mt-8 inline-flex min-h-11 items-center justify-center rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 ${
                plan.featured
                  ? 'bg-indigo-600 text-white hover:bg-indigo-700'
                  : 'border border-slate-300 bg-white text-slate-800 hover:bg-slate-50'
              }`}
            >
              {plan.cta}
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-20">
      <div class="mx-auto max-w-5xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-200 text-left">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-4 py-3 text-sm font-semibold uppercase tracking-wide text-slate-700">Feature</th>
                {plans.map((plan) => (
                  <th key={plan.key} class="px-4 py-3 text-sm font-semibold uppercase tracking-wide text-slate-700">
                    {plan.name}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              {comparisonRows.map((row) => (
                <tr class="align-top">
                  <th class="bg-slate-50 px-4 py-4 text-left text-sm font-semibold text-slate-800">{row.label}</th>
                  {plans.map((plan) => (
                    <td class="px-4 py-4 text-sm leading-6 text-slate-600">
                      {row.values[plan.key]}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="mx-auto mt-20 max-w-3xl">
      <h2 class="text-2xl font-semibold tracking-tight text-slate-950 sm:text-3xl">Frequently asked questions</h2>
      <div class="mt-8 divide-y divide-slate-200 border-y border-slate-200">
        {faqs.map((faq) => (
          <div class="py-6">
            <h3 class="text-lg font-semibold text-slate-900">{faq.q}</h3>
            <p class="mt-2 leading-7 text-slate-600">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>

    <script>
      const billingButtons = document.querySelectorAll('[data-billing-cycle]');
      const togglePrices = (cycle) => {
        const billingIsYearly = cycle === 'yearly';

        document.querySelectorAll('.monthly-price').forEach((element) => {
          element.classList.toggle('hidden', billingIsYearly);
        });

        document.querySelectorAll('.yearly-price').forEach((element) => {
          element.classList.toggle('hidden', !billingIsYearly);
        });

        billingButtons.forEach((button) => {
          const pressed = button.dataset.billingCycle === cycle;
          button.setAttribute('aria-pressed', String(pressed));
          button.classList.toggle('bg-slate-900', pressed);
          button.classList.toggle('text-white', pressed);
          button.classList.toggle('shadow-sm', pressed);
          button.classList.toggle('text-slate-700', !pressed);
        });
      };

      billingButtons.forEach((button) => {
        button.addEventListener('click', () => togglePrices(button.dataset.billingCycle));
      });
    </script>
  </main>
</Layout>
