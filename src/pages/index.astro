---
import Layout from '../layouts/layout.astro';
import { SIGNUP_URL, SITE_URL } from '../config';

const pricingPreview = [
  { name: 'Free', price: 'KES 0', detail: '100 AI replies / month' },
  { name: 'Starter', price: 'KES 300', detail: 'KES 3,000 / year' },
  { name: 'Pro', price: 'KES 600', detail: 'KES 6,000 / year' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Nudge',
    url: SITE_URL,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Nudge',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description:
      'An AI chat widget that answers customer questions from your own documents.',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'KSH',
    },
  },
];

const steps = [
  {
    number: '01',
    title: 'Add your knowledge',
    description:
      'Upload the PDFs and documents your team already uses to help customers.',
  },
  {
    number: '02',
    title: 'Make it yours',
    description:
      'Choose a name and welcome message that feel right for your business.',
  },
  {
    number: '03',
    title: 'Put it to work',
    description:
      'Add one small snippet to your site and let Nudge handle common questions.',
  },
];

const features = [
  {
    title: 'Answers grounded in your docs',
    description:
      'Nudge uses your own PDFs and guides, so customers get useful answers based on your business.',
  },
  {
    title: 'Set up without the busywork',
    description:
      'Add your documents, copy one snippet, and get a helpful chat on your website.',
  },
  {
    title: 'There when customers need you',
    description:
      'Give people a clear next step, even when your team is away or helping someone else.',
  },
  {
    title: 'Your brand, your experience',
    description:
      'Keep the conversation welcoming and consistent with the way your business speaks.',
  },
  {
    title: 'Works with your website',
    description:
      'Add Nudge to a custom site or popular website builder with a simple embed.',
  },
  {
    title: 'Clear, practical pricing',
    description:
      'Start with a free plan and choose an upgrade only when your business needs more.',
  },
];

---

<Layout
  title="Nudge | AI chat widget for answers from your business documents"
  description="Help customers get answers from your own PDFs and docs. Add Nudge, the simple AI chat widget for your website, in minutes."
  jsonLd={jsonLd}
>
  <main>
    <section class="nudge-hero">
      <div class="nudge-hero__inner">
        <div class="nudge-hero__copy">
          <h1>Helpful answers, even after hours.</h1>
          <p class="nudge-hero__subhead">Nudge answers from your business docs, so guests get help anytime.</p>
          <a class="nudge-hero__cta" href={SIGNUP_URL}>Start free</a>
          <p class="nudge-hero__payment">Pay by M-Pesa</p>
        </div>

        <div id="demo" class="nudge-scene" role="region" aria-label="Nudge chat on a guesthouse website">
          <div class="nudge-phone" aria-label="Phone displaying a guesthouse website and Nudge chat">
            <span class="nudge-phone__side-button" aria-hidden="true"></span>
            <span class="nudge-phone__power-button" aria-hidden="true"></span>
            <span class="nudge-phone__camera-cutout" aria-hidden="true"></span>
            <div class="nudge-phone__screen">
              <div class="phone-status" aria-hidden="true">
                <span>9:41</span>
                <span class="phone-status__icons">
                  <span class="phone-status__signal"></span>
                  <span class="phone-status__wifi"></span>
                  <span class="phone-status__battery"></span>
                </span>
              </div>
              <div class="guesthouse-site">
                <header class="guesthouse-site__header">
                  <span class="guesthouse-site__mark" aria-hidden="true">K</span>
                  <span class="guesthouse-site__name">Karibu House</span>
                  <span class="guesthouse-site__menu" aria-hidden="true">☰</span>
                </header>
                <div class="guesthouse-site__intro">
                  <p class="guesthouse-site__location">A LITTLE CLOSER TO HOME</p>
                  <h2>Stay awhile in Nairobi.</h2>
                  <p>Thoughtful rooms, warm welcomes, and space to make yourself at home.</p>
                  <span class="guesthouse-site__booking">Explore our rooms</span>
                </div>
              </div>

              <section class="nudge-chat" aria-label="Chat with Nudge">
                <header class="nudge-chat__header">
                  <span class="nudge-chat__status" aria-hidden="true"></span>
                  <div>
                    <p class="nudge-chat__title">Ask Karibu House</p>
                    <p class="nudge-chat__online">Here to help</p>
                  </div>
                  <span class="nudge-chat__close" aria-hidden="true">×</span>
                </header>
                <div class="nudge-chat__body">
                  <p class="nudge-chat__welcome">Hi there! How can we help with your stay?</p>
                  <div class="nudge-chat__customer">
                    <p>Do you deliver to Thika, and how much?</p>
                    <span>2:14 AM</span>
                  </div>
                  <div class="nudge-chat__reply">
                    <p class="nudge-chat__answer" data-answer="Yes, we deliver to Thika every day. Delivery is KES 300.">Yes, we deliver to Thika every day. Delivery is KES 300.</p>
                    <span class="nudge-chat__source">From: Delivery policy, p.2</span>
                  </div>
                </div>
                <div class="nudge-chat__composer">
                  <span>Write a message...</span>
                  <button type="button" aria-label="Send message" tabindex="-1">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 9.5 17 3l-4.5 14-2.2-5.3L3 9.5Zm7.3 2.2L17 3" /></svg>
                  </button>
                </div>
              </section>
            </div>
          </div>

          <article class="question-card question-card--left" style="--card-delay: 0ms">
            <span class="question-card__avatar" aria-hidden="true">W</span>
            <span class="question-card__content">
              <span class="question-card__person">Wanjiru, Nakuru</span>
              <span class="question-card__question">Do you deliver to Thika?</span>
            </span>
            <time class="question-card__time" datetime="02:14">2:14 AM</time>
          </article>
          <article class="question-card question-card--right-top" style="--card-delay: 300ms">
            <span class="question-card__avatar question-card__avatar--warm" aria-hidden="true">M</span>
            <span class="question-card__content">
              <span class="question-card__person">Mercy, Nairobi</span>
              <span class="question-card__question">Is breakfast included?</span>
            </span>
            <time class="question-card__time" datetime="01:08">1:08 AM</time>
          </article>
          <article class="question-card question-card--right-bottom" style="--card-delay: 600ms">
            <span class="question-card__avatar question-card__avatar--green" aria-hidden="true">J</span>
            <span class="question-card__content">
              <span class="question-card__person">James, Thika</span>
              <span class="question-card__question">Can I check in late?</span>
            </span>
            <time class="question-card__time" datetime="00:42">12:42 AM</time>
          </article>
        </div>
      </div>
    </section>

    <section class="landing-section landing-section--soft">
      <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
        <div class="max-w-2xl" data-scroll-reveal>
          <p class="text-sm font-semibold uppercase tracking-wide text-slate-600">How it works</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
            From your documents to a helpful chat.
          </h2>
          <p class="mt-4 text-lg text-slate-600">Three simple steps. No complicated setup.</p>
        </div>
        <ol class="mt-10 grid gap-8 md:grid-cols-3">
          {steps.map((step) => (
            <li class="landing-card rounded-2xl border border-slate-200 bg-white p-6" data-scroll-reveal style={`--reveal-delay: ${Number(step.number) * 45}ms`}>
              <p class="text-sm font-semibold text-slate-600">{step.number}</p>
              <h3 class="mt-4 text-xl font-semibold text-slate-900">{step.title}</h3>
              <p class="mt-3 leading-7 text-slate-600">{step.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="features" class="mx-auto max-w-6xl scroll-mt-8 px-6 py-20 sm:py-24">
      <div class="mx-auto max-w-2xl text-center" data-scroll-reveal>
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-600">Made to be useful</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
          A better way to answer everyday questions.
        </h2>
        <p class="mt-4 text-lg text-slate-600">Give customers quick help and give your team room to focus.</p>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((feature, index) => (
          <article class="landing-card rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-slate-300 hover:shadow-lg hover:shadow-slate-200/50" data-scroll-reveal style={`--reveal-delay: ${index * 55}ms`}>
            <span class="flex size-10 items-center justify-center rounded-xl bg-slate-100 text-sm font-semibold text-slate-600" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-5 text-lg font-semibold text-slate-900">{feature.title}</h3>
            <p class="mt-2 leading-7 text-slate-600">{feature.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="landing-section landing-section--soft">
      <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
        <div class="landing-story rounded-3xl border border-slate-200 bg-white px-6 py-12 text-center shadow-sm sm:px-12" data-scroll-reveal>
          <p class="text-sm font-semibold uppercase tracking-wide text-slate-600">Built for growing teams</p>
          <h2 class="mx-auto mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
            Thoughtful support starts with the knowledge you already have.
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-slate-600">
            Nudge is made for small businesses and developers who want to make good information easier to find.
          </p>
          <div class="mt-8 rounded-xl border border-dashed border-slate-300 bg-slate-50 px-5 py-4 text-sm text-slate-500">
            Customer stories and logos coming soon
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end" data-scroll-reveal>
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-wide text-slate-600">Pricing</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
            Start free. Grow when you’re ready.
          </h2>
          <p class="mt-4 text-lg text-slate-600">Straightforward plans for every stage of your business.</p>
        </div>
        <a
          href="/pricing"
          class="font-semibold text-[#1F4FD8] underline decoration-[#E3EAFC] underline-offset-4 hover:text-[#173DAE] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1F4FD8]"
        >
          Compare all plans
        </a>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {pricingPreview.map((plan, index) => (
          <article class="landing-card rounded-2xl border border-slate-200 bg-white p-6" data-scroll-reveal style={`--reveal-delay: ${index * 55}ms`}>
            <h3 class="text-lg font-semibold text-slate-900">{plan.name}</h3>
            <p class="mt-5 text-4xl font-semibold tracking-tight text-slate-950">{plan.price}</p>
            <p class="mt-1 text-sm text-slate-500">{plan.detail}</p>
          </article>
        ))}
      </div>
      <p class="mt-5 text-sm text-slate-500">Plan details and limits may change. See the pricing page for full details.</p>
    </section>

    <section class="landing-cta">
      <div class="mx-auto max-w-6xl px-6 py-16 text-center sm:py-20" data-scroll-reveal>
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-300">Make every answer easier</p>
        <h2 class="mx-auto mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          Give your customers a helpful answer, right when they need one.
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-slate-300">
          Bring your documents together with a chat experience that’s simple to set up.
        </p>
        <a
          href={SIGNUP_URL}
          class="mt-8 inline-flex min-h-12 items-center justify-center rounded-lg bg-[#1F4FD8] px-6 py-3 font-semibold text-white transition hover:bg-[#173DAE] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          Start free
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .nudge-hero {
    overflow: hidden;
    background: #f7f5f0;
    color: #14161b;
  }

  .landing-section--soft {
    border-block: 1px solid #e2ded5;
    background: #f0eee8;
  }

  .landing-card {
    border-color: #e2ded5;
    box-shadow: 0 2px 6px rgba(20, 22, 27, 0.025);
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .landing-card:hover {
    transform: translateY(-3px);
    border-color: #d3cec4;
    box-shadow: 0 12px 26px rgba(20, 22, 27, 0.08);
  }

  .landing-story {
    border-color: #e2ded5;
    box-shadow: 0 12px 36px rgba(20, 22, 27, 0.045);
  }

  .landing-cta {
    overflow: hidden;
    background: #14161b;
    color: #fff;
  }

  .nudge-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 48px;
    width: min(1200px, calc(100% - 48px));
    min-height: 700px;
    margin: 0 auto;
    padding: 48px 0;
  }

  .nudge-hero__copy {
    position: relative;
    z-index: 1;
    padding: 24px 0;
  }

  .nudge-hero__copy h1 {
    max-width: 520px;
    margin: 0;
    font-size: clamp(44px, 5vw, 64px);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: 1.04;
  }

  .nudge-hero__subhead {
    max-width: 500px;
    margin: 22px 0 0;
    color: #5b606b;
    font-size: 18px;
    line-height: 1.6;
  }

  .nudge-hero__cta {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    margin-top: 30px;
    padding: 0 25px;
    border-radius: 9px;
    background: #1f4fd8;
    color: white;
    font-size: 16px;
    font-weight: 650;
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .nudge-hero__cta:hover {
    background: #173dae;
  }

  .nudge-hero__cta:focus-visible {
    outline: 3px solid #1f4fd8;
    outline-offset: 3px;
  }

  .nudge-hero__payment {
    margin: 13px 0 0;
    color: #5b606b;
    font-size: 13px;
  }

  .nudge-scene {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 640px;
    align-items: center;
    justify-content: center;
    isolation: isolate;
  }

  .nudge-phone {
    position: relative;
    z-index: 1;
    width: 390px;
    height: 610px;
    padding: 23px 9px 9px;
    overflow: hidden;
    border: 1px solid #101116;
    border-radius: 42px;
    background: linear-gradient(105deg, #303138 0%, #17181d 13%, #111216 87%, #34353a 100%);
    box-shadow: 0 22px 50px rgba(20, 22, 27, 0.19), inset 0 0 0 1px rgba(255, 255, 255, 0.12);
  }

  .nudge-phone__camera-cutout {
    position: absolute;
    top: 8px;
    left: 50%;
    z-index: 3;
    width: 70px;
    height: 11px;
    transform: translateX(-50%);
    border-radius: 10px;
    background: #08090b;
  }

  .nudge-phone__camera-cutout::after {
    position: absolute;
    top: 3px;
    right: 9px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #202630;
    content: "";
  }

  .nudge-phone__side-button,
  .nudge-phone__power-button {
    position: absolute;
    z-index: 2;
    width: 3px;
    border-radius: 2px;
    background: #414248;
  }

  .nudge-phone__side-button {
    top: 108px;
    left: -3px;
    height: 47px;
    box-shadow: 0 57px 0 #414248;
  }

  .nudge-phone__power-button {
    top: 139px;
    right: -3px;
    height: 62px;
  }

  .nudge-phone__screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 31px;
    background: #fff;
  }

  .phone-status {
    position: relative;
    z-index: 1;
    display: flex;
    height: 25px;
    align-items: center;
    justify-content: space-between;
    padding: 0 17px;
    background: #fbfaf7;
    color: #24252a;
    font-family: Arial, sans-serif;
    font-size: 9px;
    font-weight: 700;
  }

  .phone-status__icons {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .phone-status__signal {
    width: 11px;
    height: 8px;
    background: linear-gradient(to right, #292a2f 0 22%, transparent 22% 30%, #292a2f 30% 52%, transparent 52% 60%, #292a2f 60% 78%, transparent 78% 84%, #292a2f 84%);
    clip-path: polygon(0 100%, 0 72%, 22% 72%, 22% 50%, 44% 50%, 44% 29%, 66% 29%, 66% 8%, 100% 8%, 100% 100%);
  }

  .phone-status__wifi {
    width: 11px;
    height: 8px;
    border: 1.5px solid #292a2f;
    border-color: #292a2f transparent transparent;
    border-radius: 50%;
  }

  .phone-status__battery {
    position: relative;
    width: 14px;
    height: 7px;
    border: 1px solid #292a2f;
    border-radius: 2px;
  }

  .phone-status__battery::before {
    position: absolute;
    inset: 1px 3px 1px 1px;
    border-radius: 1px;
    background: #292a2f;
    content: "";
  }

  .phone-status__battery::after {
    position: absolute;
    top: 1px;
    right: -3px;
    width: 2px;
    height: 3px;
    border-radius: 0 1px 1px 0;
    background: #292a2f;
    content: "";
  }

  .guesthouse-site {
    height: 100%;
    background: #fbfaf7;
  }

  .guesthouse-site__header {
    display: flex;
    height: 66px;
    align-items: center;
    gap: 9px;
    padding: 0 18px;
    border-bottom: 1px solid #e8e5df;
  }

  .guesthouse-site__mark {
    display: grid;
    width: 27px;
    height: 27px;
    place-items: center;
    border: 1px solid #c8bba9;
    border-radius: 50%;
    color: #5f513f;
    font-family: Georgia, serif;
    font-size: 15px;
  }

  .guesthouse-site__name {
    color: #302d29;
    font-family: Georgia, serif;
    font-size: 15px;
    font-weight: 600;
  }

  .guesthouse-site__menu {
    margin-left: auto;
    color: #5b606b;
    font-size: 19px;
  }

  .guesthouse-site__intro {
    padding: 38px 23px 0;
    color: #302d29;
  }

  .guesthouse-site__location {
    margin: 0;
    color: #777064;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .guesthouse-site__intro h2 {
    margin: 10px 0 8px;
    font-family: Georgia, serif;
    font-size: 27px;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .guesthouse-site__intro > p:not(.guesthouse-site__location) {
    max-width: 275px;
    margin: 0;
    color: #706e69;
    font-size: 12px;
    line-height: 1.55;
  }

  .guesthouse-site__booking {
    display: inline-flex;
    margin-top: 17px;
    padding: 9px 13px;
    border: 1px solid #d5d0c8;
    border-radius: 4px;
    color: #45413b;
    font-size: 10px;
    font-weight: 600;
  }

  .nudge-chat {
    position: absolute;
    right: 12px;
    bottom: 13px;
    left: 12px;
    z-index: 2;
    overflow: hidden;
    border: 1px solid #e2ded5;
    border-radius: 15px;
    background: #fff;
    box-shadow: 0 6px 22px rgba(20, 22, 27, 0.13);
    color: #14161b;
    font-family: Arial, sans-serif;
  }

  .nudge-chat__header {
    display: flex;
    min-height: 61px;
    align-items: center;
    gap: 10px;
    padding: 10px 13px;
    background: #1f4fd8;
    color: #fff;
  }

  .nudge-chat__status {
    width: 9px;
    height: 9px;
    border: 2px solid rgba(255, 255, 255, 0.8);
    border-radius: 50%;
  }

  .nudge-chat__title,
  .nudge-chat__online,
  .nudge-chat__welcome,
  .nudge-chat__customer p,
  .nudge-chat__reply p {
    margin: 0;
  }

  .nudge-chat__title {
    font-size: 13px;
    font-weight: 700;
  }

  .nudge-chat__online {
    margin-top: 3px;
    color: #e3eafc;
    font-size: 10px;
  }

  .nudge-chat__close {
    margin-left: auto;
    font-size: 23px;
    font-weight: 300;
    line-height: 1;
  }

  .nudge-chat__body {
    display: flex;
    min-height: 234px;
    flex-direction: column;
    gap: 13px;
    padding: 15px 13px 13px;
  }

  .nudge-chat__welcome,
  .nudge-chat__customer,
  .nudge-chat__reply {
    max-width: 90%;
    border-radius: 11px;
    padding: 10px 11px;
    font-size: 11px;
    line-height: 1.45;
  }

  .nudge-chat__welcome,
  .nudge-chat__reply {
    align-self: flex-start;
    background: #f2f1ee;
    color: #30323a;
  }

  .nudge-chat__customer {
    align-self: flex-end;
    background: #e3eafc;
    color: #222b42;
  }

  .nudge-chat__customer span {
    display: block;
    margin-top: 5px;
    color: #5b606b;
    font-size: 9px;
    text-align: right;
  }

  .nudge-chat__reply {
    max-width: 96%;
    padding-bottom: 8px;
  }

  .nudge-chat__answer {
    min-height: 32px;
  }

  .nudge-chat__source {
    display: inline-flex;
    margin-top: 7px;
    padding: 3px 6px;
    border-radius: 4px;
    background: #e3eafc;
    color: #1f4fd8;
    font-family: "Courier New", monospace;
    font-size: 9px;
  }

  .nudge-chat__composer {
    display: flex;
    height: 48px;
    align-items: center;
    justify-content: space-between;
    padding: 0 10px 0 13px;
    border-top: 1px solid #e2ded5;
