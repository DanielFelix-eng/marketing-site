---
import Layout from '../layouts/Layout.astro';

const APP_URL = 'https://.jardini.xyz';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'NUDGE',
    url: 'https://jardini.xyz',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'NUDGE',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description:
      'An AI chat widget that answers customer questions from your own documents.',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'KSH',
    },
  },
];
---

<Layout
  title="YourProduct: AI Chat Widget for Customer Support"
  description="Add an AI chat widget to your website that answers customer questions from your own PDFs and docs. Set up in minutes."
  jsonLd={jsonLd}
>
  <main>
    <h1>AI chat widget that answers from your own documents</h1>
    <p>
      YourProduct is an embeddable AI chat widget. Upload your PDFs and docs,
      paste one script tag on your site, and customers get accurate answers
      instantly.
    </p>
    <a href={`${APP_URL}/signup`}>Start free</a>
    <a href={`${APP_URL}/login`}>Log in</a>
  </main>
</Layout>