  @media (prefers-reduced-motion: reduce) {
    .nudge-scene.has-reveal .question-card {
      opacity: 1;
      transition: none;
      transform: none;
    }

    .nudge-scene.has-reveal.is-visible .question-card {
      transition: none;
    }

    .landing-card,
    .landing-card:hover {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const revealItems = document.querySelectorAll<HTMLElement>('[data-scroll-reveal]');
  const scene = document.querySelector<HTMLElement>('.nudge-scene');
  const answer = document.querySelector<HTMLElement>('.nudge-chat__answer');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reducedMotion && revealItems.length > 0) {
    document.documentElement.classList.add('scroll-effects-ready');
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -35px 0px' },
    );
    revealItems.forEach((item) => revealObserver.observe(item));
  }

  if (scene && !reducedMotion) {
    scene.classList.add('has-reveal');
    const reveal = () => {
      scene.classList.add('is-visible');
      if (!answer) return;

      const fullAnswer = answer.dataset.answer ?? answer.textContent ?? '';
      window.setTimeout(() => {
        let character = 0;
        answer.textContent = '';
        const typing = window.setInterval(() => {
          answer.textContent = fullAnswer.slice(0, character + 1);
          character += 1;
          if (character >= fullAnswer.length) window.clearInterval(typing);
        }, 24);
      }, 1120);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          reveal();
        }
      },
      { threshold: 0.25 },
    );
    observer.observe(scene);
  }
</script>
