---
import { LOGIN_URL, SIGNUP_URL } from '../config';
---
<footer class="mt-24 border-t border-[#E2DED5]" data-scroll-reveal>
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-8 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between">
    <p>© {new Date().getFullYear()} Nudge. Helpful answers, made simple.</p>
    <nav aria-label="Footer navigation" class="flex flex-wrap gap-x-5 gap-y-2">
      <a href="/pricing" class="w-fit font-medium text-slate-600 underline decoration-slate-300 underline-offset-4 hover:text-[#173DAE] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1F4FD8]">
        Pricing
      </a>
      <a href={LOGIN_URL} class="w-fit font-medium text-slate-600 underline decoration-slate-300 underline-offset-4 hover:text-[#173DAE] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1F4FD8]">
        Log in
      </a>
      <a href={SIGNUP_URL} class="w-fit font-medium text-slate-600 underline decoration-slate-300 underline-offset-4 hover:text-[#173DAE] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1F4FD8]">
        Sign up
      </a>
      <a href="/privacy" class="w-fit font-medium text-slate-600 underline decoration-slate-300 underline-offset-4 hover:text-[#173DAE] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1F4FD8]">
        Privacy
      </a>
      <a href="/terms" class="w-fit font-medium text-slate-600 underline decoration-slate-300 underline-offset-4 hover:text-[#173DAE] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1F4FD8]">
        Terms
      </a>
    </nav>
  </div>
</footer>